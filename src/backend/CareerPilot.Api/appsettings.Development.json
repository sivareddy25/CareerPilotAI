{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=careerpilot;Username=careerpilot;Password=SecretPassword123!",
    "EnableSensitiveDataLogging": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "careerpilot-web",
    "//SigningKey": "Local development only. Every other environment must supply this from a secret store — user-secrets, environment variable, or a vault — never from a file in source control.",
    "SigningKey": "development-only-signing-key-change-me-32b+",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Playwright": {
    "Headless": false,
    "SlowMoMilliseconds": 100
  }
}
