{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true
  },
  "Database": {
    "ConnectionString": "",
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "careerpilot:",
    "DefaultExpirationMinutes": 60
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Authentication": {
    "MinimumPasswordLength": 12,
    "MaximumPasswordLength": 72,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordHashWorkFactor": 12,
    "DefaultRole": "User",
    "SlidingRefreshExpiration": true,
    "RefreshTokenAbsoluteLifetimeDays": 30,
    "RefreshTokenCookie": {
      "Enabled": false,
      "Path": "/api/v1/auth",
      "Domain": ""
    }
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "/media"
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 10,
    "AuthenticationWindowSeconds": 60,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "",
    "BaseUrl": "",
    "TimeoutSeconds": 100,
    "MaxRetries": 2
  },
  "Playwright": {
    "Headless": true,
    "Browser": "chromium",
    "NavigationTimeoutSeconds": 30,
    "SlowMoMilliseconds": 0,
    "DownloadsPath": ""
  }
}
