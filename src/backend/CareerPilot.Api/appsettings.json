{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true
  },
  "Database": {
    "ConnectionString": "",
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "careerpilot:",
    "DefaultExpirationMinutes": 60
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "",
    "BaseUrl": "",
    "TimeoutSeconds": 100,
    "MaxRetries": 2
  },
  "Playwright": {
    "Headless": true,
    "Browser": "chromium",
    "NavigationTimeoutSeconds": 30,
    "SlowMoMilliseconds": 0,
    "DownloadsPath": ""
  }
}
