# CareerPilot AI local-development configuration. Copy to .env; never commit .env.
# The bootstrap scripts use these values for Docker and native development.
POSTGRES_PASSWORD=SecretPassword123!
REDIS_PASSWORD=

# Security Keys
JWT_SECRET_KEY=SuperSecretJwtKeyWithMinimum32CharactersLength!

# Multi-LLM API Keys
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local application endpoints
API_URL=http://localhost:5080
WEB_URL=http://localhost:4200
