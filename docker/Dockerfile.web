# CareerPilot AI — Web image (Phase 1 placeholder).
#
# Compiles the Angular bundle, then serves the static output from nginx.
# Build context is the REPOSITORY ROOT, not this folder:
#   docker build -f docker/Dockerfile.web -t careerpilot-web .

# ---- build ----
FROM node:24-alpine AS build
WORKDIR /src

# Copy lockfiles first so `npm ci` is cached independently of source edits.
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci

COPY src/frontend/ ./
RUN npm run build

# ---- runtime ----
FROM nginx:alpine AS final

# SPA fallback: unknown paths must return index.html so the Angular
# router owns client-side routing instead of nginx returning 404.
RUN printf '%s\n' \
    'server {' \
    '  listen 80;' \
    '  root /usr/share/nginx/html;' \
    '  include /etc/nginx/mime.types;' \
    '  location / {' \
    '    try_files $uri $uri/ /index.html;' \
    '  }' \
    '}' > /etc/nginx/conf.d/default.conf

# Angular 22 emits browser assets under dist/<project>/browser.
COPY --from=build /src/dist/careerpilot-web/browser /usr/share/nginx/html

EXPOSE 80
